    {
      "name": "liftCoefficient",
      "var_id": "CL",
      "units": "nd",
      "axis_system": "stability axes",
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <plus />\n          <ci>CL_basic</ci>\n          <apply>\n            <times />\n            <ci>CLq</ci>\n            <ci>qhat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>CLde</ci>\n            <ci>de</ci>\n          </apply>\n        </apply>\n      </math>"
      },
      "is_output": true
    },
    {
      "name": "liftCoefficientLinear",
      "var_id": "CL_linear",
      "units": "nd",
      "axis_system": "stability axes",
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <plus />\n          <ci>CL0</ci>\n          <apply>\n            <times />\n            <ci>CLa</ci>\n            <ci>alpha</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>CLq</ci>\n            <ci>qhat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>CLde</ci>\n            <ci>de</ci>\n          </apply>\n        </apply>\n      </math>"
      }
    },
    {
      "name": "dragCoefficient",
      "var_id": "CD",
      "units": "nd",
      "axis_system": "stability axes",
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <plus />\n          <ci>CD0</ci>\n          <apply>\n            <times />\n            <ci>K</ci>\n            <apply>\n              <power />\n              <ci>CL_linear</ci>\n              <cn>2</cn>\n            </apply>\n          </apply>\n          <apply>\n            <times />\n            <ci>CDde</ci>\n            <apply>\n              <abs />\n              <ci>de</ci>\n            </apply>\n          </apply>\n        </apply>\n      </math>"
      },
      "is_output": true
    },
    {
      "name": "sideForceCoefficient",
      "var_id": "CY",
      "units": "nd",
      "axis_system": "stability axes",
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <plus />\n          <apply>\n            <times />\n            <ci>CYb</ci>\n            <ci>beta</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>CYp</ci>\n            <ci>phat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>CYr</ci>\n            <ci>rhat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>CYdr</ci>\n            <ci>dr</ci>\n          </apply>\n        </apply>\n      </math>"
      },
      "is_output": true
    },
    {
      "name": "rollMomentCoefficient",
      "var_id": "Cl",
      "units": "nd",
      "axis_system": "stability axes",
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <plus />\n          <apply>\n            <times />\n            <ci>Clb</ci>\n            <ci>beta</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Clp</ci>\n            <ci>phat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Clr</ci>\n            <ci>rhat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Clda</ci>\n            <ci>da</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Cldr</ci>\n            <ci>dr</ci>\n          </apply>\n        </apply>\n      </math>"
      },
      "is_output": true
    },
    {
      "name": "pitchMomentCoefficient",
      "var_id": "Cm",
      "units": "nd",
      "axis_system": "stability axes",
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <plus />\n          <ci>Cm0</ci>\n          <apply>\n            <times />\n            <ci>Cma</ci>\n            <ci>alpha</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Cmq</ci>\n            <ci>qhat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Cmde</ci>\n            <ci>de</ci>\n          </apply>\n        </apply>\n      </math>"
      },
      "is_output": true
    },
    {
      "name": "yawMomentCoefficient",
      "var_id": "Cn",
      "units": "nd",
      "axis_system": "stability axes",
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <plus />\n          <apply>\n            <times />\n            <ci>Cnb</ci>\n            <ci>beta</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Cnp</ci>\n            <ci>phat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Cnr</ci>\n            <ci>rhat</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Cnda</ci>\n            <ci>da</ci>\n          </apply>\n          <apply>\n            <times />\n            <ci>Cndr</ci>\n            <ci>dr</ci>\n          </apply>\n        </apply>\n      </math>"
      },
      "is_output": true
    }
