      "sign": "+ANU",
      "initial_value": "0.0",
      "description": {
        "value": "Net steady-state moment of the engine for given flight conditions, power lever angle, about the\n      body Y axis"
      },
      "is_output": true,
      "is_std_aiaa": true
    },
    {
      "name": "thrustBodyMoment_Yaw",
      "var_id": "TEN",
      "units": "ftlbf",
      "sign": "+ANR",
      "initial_value": "0.0",
      "description": {
        "value": "Net steady-state moment of the engine for given flight conditions, power lever angle, about the\n      body Z axis"
      },
      "is_output": true,
      "is_std_aiaa": true
    }
  ],
