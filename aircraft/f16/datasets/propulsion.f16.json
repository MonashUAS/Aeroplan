      },
      "is_output": true,
      "is_std_aiaa": true
    },
    {
      "name": "thrustBodyMoment_Roll",
      "var_id": "TEL",
      "units": "ftlbf",
      "sign": "+RWD",
      "initial_value": "0.0",
      "description": {
        "value": "Net steady-state moment of the engine for given flight conditions, power lever angle, about the\n      body X axis"
      },
      "is_output": true,
      "is_std_aiaa": true
    },
    {
      "name": "thrustBodyMoment_Pitch",
      "var_id": "TEM",
