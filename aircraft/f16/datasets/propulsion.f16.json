      "date": "2012-08-07"
    },
    "file_version": {
      "value": "Initial version"
    },
    "description": {
      "value": "A simple propulsion model for the F-16 Fighting Falcon, as described in Stevens & Lewis [01]."
    },
    "reference": [
      {
        "ref_id": "REF01",
        "author": "Stevens, Brian L. and Lewis, Frank L.",
        "title": "Aircraft control and Simulation, 2nd Edition",
        "accession": "ISBN 0-471-37145-9",
        "date": "2003-01-01"
      }
    ]
  },
  "variable_def": [
    {
      "name": "powerLeverAngle",
      "var_id": "PWR",
      "units": "pct",
      "sign": "+INCR",
      "initial_value": "0.0",
      "description": {
        "value": "Throttle (power lever angle), 0 - 100. 50 is MIL (max dry) thrust; 100 is MAX (burner)"
      },
      "is_input": true
    },
    {
      "name": "altitudeMSL",
      "var_id": "ALT",
      "units": "ft",
      "sign": "+INCR",
      "initial_value": "0.0",
      "description": {
        "value": "Altitude above sea level"
      },
      "is_input": true,
      "is_std_aiaa": true
    },
    {
      "name": "mach",
      "var_id": "RMACH",
      "units": "nd",
      "sign": "+INCR",
      "initial_value": "0.0",
      "description": {
        "value": "Flight Mach number"
      },
      "is_input": true,
      "is_std_aiaa": true
    },
    {
      "name": "milPwr",
      "var_id": "MIL_PWR",
      "units": "nd",
      "sign": "+INCR",
      "initial_value": "50.0",
      "description": {
        "value": "Power lever angle for military power - above this, we get afterburners"
      }
    },
    {
      "name": "idleThrust",
      "var_id": "T_IDLE",
      "units": "lb",
      "sign": "+INCR",
      "initial_value": "0.",
      "description": {
        "value": "Idle thrust at current flight conditions with power at 0. Output of function table."
      }
    },
    {
      "name": "militaryThrust",
      "var_id": "T_MIL",
      "units": "lb",
      "sign": "+INCR",
      "initial_value": "0.",
      "description": {
        "value": "Max dry thrust at current flight conditions with power at 50. Output of function table."
      }
    },
    {
      "name": "maxThrust",
      "var_id": "T_MAX",
      "units": "lb",
      "sign": "+INCR",
      "initial_value": "0.",
      "description": {
        "value": "Max augmented thrust at current flight conditions with power at 100. Output of function table."
      }
    },
    {
      "name": "thrustBodyForce_X",
      "var_id": "FEX",
      "units": "lbf",
      "sign": "FWD",
      "description": {
        "value": "Net steady-state thrust of the engine for given flight conditions, power lever angle, in the\n      body X axis.\n\n      If PWR below MIL_PWR, interpolate between T_IDLE and T_MIL.\n\n      If PWR is above MIL_PWR, interpolate between T_MAX and T_MIL."
      },
      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n\t<apply>\n\t  <piecewise>\n\t    <piece>                 \n              <apply>      \n\t\t<plus />\n\t\t<ci>T_IDLE</ci>\n\t\t<apply>\n\t\t  <divide />\n\t\t  <apply>\n\t\t    <times />\n\t\t    <ci>PWR</ci>\n\t\t    <apply>\n\t\t      <minus />\n\t\t      <ci>T_MIL</ci>\n\t\t      <ci>T_IDLE</ci></apply>\n\t\t  </apply>\n\t\t  <ci>MIL_PWR</ci>\n\t\t</apply>\n\t      </apply>\n\t      <apply>                \n\t\t<lt />\n\t\t<ci>PWR</ci>\n\t\t<ci>MIL_PWR</ci> \n\t      </apply>\n\t    </piece>               \n\t    <otherwise>            \n\t      <apply>      \n\t\t<plus />\n\t\t<ci>T_MIL</ci>\n\t\t<apply>\n\t\t  <divide />\n\t\t  <apply>\n\t\t    <times />\n\t\t    <apply>\n\t\t      <minus />\n\t\t      <ci>PWR</ci>\n\t\t      <ci>MIL_PWR</ci>\n\t\t    </apply>\n\t\t    <apply>\n\t\t      <minus />\n\t\t      <ci>T_MAX</ci>\n\t\t      <ci>T_MIL</ci>\n\t\t    </apply>\n\t\t  </apply>\n\t\t  <apply>\n\t\t    <minus />\n\t\t    <cn>100.0</cn>\n\t\t    <ci>MIL_PWR</ci>\n\t\t  </apply>\n\t\t</apply>\n\t      </apply>\n\t    </otherwise>\n\t  </piecewise>\n\t</apply>\n      </math>"
      },
      "is_output": true,
      "is_std_aiaa": true
    },
    {
      "name": "thrustBodyForce_Y",
      "var_id": "FEY",
      "units": "lbf",
      "sign": "+RT",
      "initial_value": "0.0",
      "description": {
        "value": "Net steady-state thrust of the engine for given flight conditions, power lever angle, in the\n      body Y axis"
      },
      "is_output": true,
      "is_std_aiaa": true
    },
    {
      "name": "thrustBodyForce_Z",
