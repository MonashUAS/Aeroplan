      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <minus />\n          <apply>\n            <plus />\n            <apply>\n              <times />\n              <ci>longLQR21</ci>\n              <ci>deltaVequiv</ci>\n            </apply>\n            <apply>\n              <times />\n              <ci>longLQR22</ci>\n              <ci>deltaAlpha</ci>\n            </apply>\n            <apply>\n              <times />\n              <ci>longLQR23</ci>\n              <ci>qb</ci>\n            </apply>\n            <apply>\n              <times />\n              <ci>longLQR24</ci>\n              <ci>deltaTheta</ci>\n            </apply>\n          </apply>\n        </apply>\n      </math>"
      }
    },
