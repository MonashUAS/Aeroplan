      "calculation": {
        "math": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <minus />\n          <apply>\n            <plus />\n            <apply>\n              <times />\n              <ci>longLQR11</ci>\n              <ci>deltaVequiv</ci>\n            </apply>\n            <apply>\n              <times />\n              <ci>longLQR12</ci>\n              <ci>deltaAlpha</ci>\n            </apply>\n            <apply>\n              <times />\n              <ci>longLQR13</ci>\n              <ci>qb</ci>\n            </apply>\n            <apply>\n              <times />\n              <ci>longLQR14</ci>\n              <ci>deltaTheta</ci>\n            </apply>\n          </apply>\n        </apply>\n      </math>"
      }
    },
