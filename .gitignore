__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
standards/adh/build/
*.egg-info/
build/
dist/
docs/_build/
# Raw tool files: work/<tool>/<aircraft>/ on the user's machine. They never go to GitHub.
work/
# The retired export package 0.1.0 (input of the one-time seed only) and partial writes of an aircraft file
aircraft/*.h5
*.muas.tmp

# the Python of a tool on this machine (aeroplan setup OpenVSP, aeroplan setup AeroSandbox)
aeroplan/openvsp/.venv/
aeroplan/aerosandbox/.venv/

# the AeroPlan Python of a checkout (uv venv .venv)
.venv/

# Claude Code: the state file of the stop hook (.claude/hooks/aeroplan_hook.py) and personal settings
.claude/hooks/.last_ok
# The blade files come from the PRIVATE Proptimiser repository, and this repository is public. Git ignores them until the
# owner decides to publish them. To publish: delete the next two lines.
aeroplan/aerosandbox/data/proptimiser/*/designs/
aeroplan/aerosandbox/data/proptimiser/*/propellers/
.claude/settings.local.json

# remove LLM context files
.claude/
CLAUDE.md
