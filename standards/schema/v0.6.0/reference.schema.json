{
  "$defs": {
    "Mrp": {
      "additionalProperties": false,
      "properties": {
        "config_id": {
          "title": "Config Id",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/MrpDefinition",
          "default": "nominal_cg"
        },
        "mass_properties_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass Properties Sha256"
        },
        "point": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "config_id",
        "point"
      ],
      "title": "Mrp",
      "type": "object"
    },
    "MrpDefinition": {
      "enum": [
        "nominal_cg"
      ],
      "title": "MrpDefinition",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": "design",
          "default": "design",
          "title": "Frame",
          "type": "string"
        },
        "units": {
          "default": "m",
          "title": "Units",
          "type": "string"
        },
        "xyz": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Xyz",
          "type": "array"
        }
      },
      "required": [
        "xyz"
      ],
      "title": "Position",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body_frame": {
      "const": "FRD",
      "default": "FRD",
      "title": "Body Frame",
      "type": "string"
    },
    "design_frame": {
      "default": "x_fwd_y_right_z_down_m_wingLE",
      "enum": [
        "x_fwd_y_right_z_down_m_wingLE",
        "x_fwd_y_right_z_down_m_bodyOrigin"
      ],
      "title": "Design Frame",
      "type": "string"
    },
    "euler": {
      "const": "3-2-1/NED",
      "default": "3-2-1/NED",
      "title": "Euler",
      "type": "string"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "multirotor",
            "quadplane"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Absent: a fixed-wing aircraft (the reference values Sref, BLref, Cbar are the wing). multirotor: Sref is the frontal area of the body, BLref the hub-to-hub span in y, Cbar the hub-to-hub length in x. quadplane: a fixed wing (the reference values are the wing) with lift rotors on booms (propeller role lift, motor 5 and up) and one cruise propeller. The vehicle kind selects what Aerolink needs (aeroplan.consumers.FLIGHT_ITEMS_BY_KIND)",
      "title": "Kind"
    },
    "mrp": {
      "$ref": "#/$defs/Mrp"
    },
    "nominal_cg": {
      "$ref": "#/$defs/Position"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "placeholder_fields": {
      "description": "Fields whose values are stand-ins. s_ref, b_ref and c_ref name the ADH reference values Sref, BLref and Cbar",
      "items": {
        "type": "string"
      },
      "title": "Placeholder Fields",
      "type": "array"
    },
    "surface_signs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Surface Signs",
      "type": "object"
    }
  },
  "required": [
    "nominal_cg",
    "mrp"
  ],
  "title": "ReferenceData",
  "type": "object"
}
