{
  "$defs": {
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "default_weight": {
          "default": 1.0,
          "title": "Default Weight",
          "type": "number"
        },
        "effect": {
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "effect"
      ],
      "title": "Correction",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "standard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "adh_upstream": {
          "default": "96179ca+patches",
          "title": "Adh Upstream",
          "type": "string"
        },
        "commit": {
          "title": "Commit",
          "type": "string"
        },
        "data_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Commit"
        },
        "data_repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Repo"
        },
        "muas_schema_version": {
          "default": "0.1.0",
          "title": "Muas Schema Version",
          "type": "string"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "commit"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_id": {
      "title": "Config Id",
      "type": "string"
    },
    "corrections": {
      "items": {
        "$ref": "#/$defs/Correction"
      },
      "title": "Corrections",
      "type": "array"
    },
    "datasets_used": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Datasets Used",
      "type": "array"
    },
    "fidelity_summary": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Fidelity Summary",
      "type": "object"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "frames": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Frames",
      "type": "object"
    },
    "known_limits": {
      "items": {
        "type": "string"
      },
      "title": "Known Limits",
      "type": "array"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "package_spec": {
      "default": "muas-export/1.0.0",
      "title": "Package Spec",
      "type": "string"
    },
    "placeholder": {
      "default": false,
      "description": "True when any value is a stand-in",
      "title": "Placeholder",
      "type": "boolean"
    },
    "reference": {
      "additionalProperties": true,
      "title": "Reference",
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    }
  },
  "required": [
    "package_id",
    "sha256",
    "source",
    "config_id",
    "fidelity_summary",
    "frames",
    "reference",
    "files"
  ],
  "title": "PackageManifest",
  "type": "object"
}
