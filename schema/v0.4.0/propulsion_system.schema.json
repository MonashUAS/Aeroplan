{
  "$defs": {
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "title": "Units",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "units"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A pointer to a raw file that a spoke read: an asset of the register (1.10.2). The file stays linked.",
      "properties": {
        "asset": {
          "pattern": "^asset:sha256:[0-9a-f]{64}$",
          "title": "Asset",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "role": {
          "description": "What the file gave, for example 'T7 stability point'",
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "tool": {
          "description": "The spoke that read the file, for example flow5",
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "asset",
        "role"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The propulsion system that flies, from a Propalyser contract B file. Its Ct/Cp table and throttle map are a\ndataset (`PropulsionTables`, role propulsion) in `muas.datasets` of the same node.",
  "properties": {
    "basis": {
      "description": "stand, vendor or mixed (contract B)",
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "blades": {
      "minimum": 1,
      "title": "Blades",
      "type": "integer"
    },
    "diameter": {
      "$ref": "#/$defs/Quantity"
    },
    "ixx": {
      "$ref": "#/$defs/Quantity",
      "description": "Propeller moment of inertia about the shaft"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "p_max": {
      "$ref": "#/$defs/Quantity",
      "description": "Shaft power at full command, the scale of power_fraction"
    },
    "placeholder": {
      "default": false,
      "title": "Placeholder",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "system_id": {
      "minLength": 1,
      "title": "System Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "system_id",
    "basis",
    "p_max",
    "diameter",
    "blades",
    "ixx",
    "source"
  ],
  "title": "PropulsionSystemData",
  "type": "object"
}
