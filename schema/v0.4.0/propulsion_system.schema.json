{
  "$defs": {
    "BatteryData": {
      "additionalProperties": false,
      "description": "The battery of a propulsion system (contract B /battery). The file has no internal resistance.",
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cell_v_max": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cell_v_min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cells_p": {
          "minimum": 1,
          "title": "Cells P",
          "type": "integer"
        },
        "cells_s": {
          "minimum": 1,
          "title": "Cells S",
          "type": "integer"
        },
        "mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "v_nominal": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "cells_s",
        "cells_p",
        "v_nominal"
      ],
      "title": "BatteryData",
      "type": "object"
    },
    "EscData": {
      "additionalProperties": false,
      "description": "The ESC of a propulsion system (contract B /esc).",
      "properties": {
        "imax_continuous": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "pwm_high": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pwm_low": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vmax": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EscData",
      "type": "object"
    },
    "MotorData": {
      "additionalProperties": false,
      "description": "The motor of a propulsion system (contract B /motor). kappa, r_tot and q0 are the constants of the chain that\nmade the contract file: d*V_bus = omega/(kappa*Kv) + r_tot*I, I = i0 + (Q + q0)*Kv.",
      "properties": {
        "i0": {
          "$ref": "#/$defs/Quantity",
          "description": "No-load current"
        },
        "imax_continuous": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kappa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ESC voltage factor of the chain (nd)",
          "title": "Kappa"
        },
        "kv": {
          "$ref": "#/$defs/Quantity",
          "description": "Speed constant, given as rpm/V"
        },
        "mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pole_pairs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pole Pairs"
        },
        "q0": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Friction torque of the chain (only when the rpm was measured)"
        },
        "r": {
          "$ref": "#/$defs/Quantity",
          "description": "Winding resistance (maker value)"
        },
        "r_tot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Motor, ESC and lead resistance of the chain"
        },
        "vmax": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kv",
        "r",
        "i0"
      ],
      "title": "MotorData",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "title": "Units",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "units"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A pointer to a raw file that a spoke read: an asset of the register (1.10.2). The file stays linked.",
      "properties": {
        "asset": {
          "pattern": "^asset:sha256:[0-9a-f]{64}$",
          "title": "Asset",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "role": {
          "description": "What the file gave, for example 'T7 stability point'",
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "tool": {
          "description": "The spoke that read the file, for example flow5",
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "asset",
        "role"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The propulsion system that flies, from a Propalyser contract B file. Its Ct/Cp table and throttle map are a\ndataset (`PropulsionTables`, role propulsion) in `muas.datasets` of the same node.",
  "properties": {
    "basis": {
      "description": "stand, vendor or mixed (contract B)",
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/BatteryData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blades": {
      "minimum": 1,
      "title": "Blades",
      "type": "integer"
    },
    "diameter": {
      "$ref": "#/$defs/Quantity"
    },
    "esc": {
      "anyOf": [
        {
          "$ref": "#/$defs/EscData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ixx": {
      "$ref": "#/$defs/Quantity",
      "description": "Propeller moment of inertia about the shaft"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "motor": {
      "anyOf": [
        {
          "$ref": "#/$defs/MotorData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "p_max": {
      "$ref": "#/$defs/Quantity",
      "description": "Shaft power at full command, the scale of power_fraction"
    },
    "placeholder": {
      "default": false,
      "title": "Placeholder",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "system_id": {
      "minLength": 1,
      "title": "System Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "system_id",
    "basis",
    "p_max",
    "diameter",
    "blades",
    "ixx",
    "source"
  ],
  "title": "PropulsionSystemData",
  "type": "object"
}
